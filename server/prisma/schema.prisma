generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  passwordHash   String
  role           Role           @default(STUDENT)
  firstName      String
  lastName       String
  faceDescriptor String?        // JSON string of facial embedding vectors
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  coursesTeaching Course[]      @relation("TeacherCourses")
  enrollments    Enrollment[]
  attendances    AttendanceRecord[]
  submissions    Submission[]
  masteryScores  MasteryScore[]
}

model Course {
  id          String         @id @default(uuid())
  code        String         @unique
  title       String
  description String?
  teacherId   String
  teacher     User           @relation("TeacherCourses", fields: [teacherId], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  enrollments Enrollment[]
  sessions    ClassSession[]
  assessments Assessment[]
  concepts    Concept[]
}

model Enrollment {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model ClassSession {
  id          String             @id @default(uuid())
  courseId    String
  title       String
  sessionDate DateTime           @default(now())
  qrCodeToken String?
  isActive    Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  course      Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  attendances AttendanceRecord[]
}

model AttendanceRecord {
  id           String           @id @default(uuid())
  sessionId    String
  userId       String
  status       AttendanceStatus @default(PRESENT)
  verifiedBy   String           @default("QR") // "QR" | "FACE" | "MANUAL"
  timestamp    DateTime         @default(now())

  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
}

model Assessment {
  id          String       @id @default(uuid())
  courseId    String
  title       String
  description String?
  maxScore    Float        @default(100)
  dueDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions Submission[]
}

model Submission {
  id           String    @id @default(uuid())
  assessmentId String
  userId       String
  content      String?
  fileUrl      String?
  score        Float?
  feedback     String?
  submittedAt  DateTime  @default(now())
  gradedAt     DateTime?

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, userId])
}

model MasteryScore {
  id        String   @id @default(uuid())
  userId    String
  topic     String
  level     Float    @default(0.0) // 0 to 100 percentage
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topic])
}

enum ResourceDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ResourceType {
  DOCUMENT
  VIDEO
  ARTICLE
  EXERCISE
}

model Concept {
  id             String                @id @default(uuid())
  title          String
  description    String?
  order          Int                   @default(0)
  courseId       String
  course         Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  resources      Resource[]
  prerequisites  ConceptPrerequisite[] @relation("ConceptPrerequisites")
  prerequisiteFor ConceptPrerequisite[] @relation("ConceptPrerequisiteFor")
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
}

model ConceptPrerequisite {
  id             String   @id @default(uuid())
  conceptId      String
  prerequisiteId String
  concept        Concept  @relation("ConceptPrerequisites", fields: [conceptId], references: [id], onDelete: Cascade)
  prerequisite   Concept  @relation("ConceptPrerequisiteFor", fields: [prerequisiteId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([conceptId, prerequisiteId])
}

model Resource {
  id          String             @id @default(uuid())
  title       String
  description String?
  url         String?
  type        ResourceType       @default(ARTICLE)
  difficulty  ResourceDifficulty @default(BEGINNER)
  conceptId   String
  concept     Concept            @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}
