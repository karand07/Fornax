generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  FLAGGED
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  passwordHash   String
  role           Role           @default(STUDENT)
  firstName      String
  lastName       String
  faceDescriptor String?        // JSON string of facial embedding vectors
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  coursesTeaching Course[]      @relation("TeacherCourses")
  enrollments    Enrollment[]
  attendances    AttendanceRecord[]
  submissions    Submission[]
  masteryScores  MasteryScore[]
  masteries      Mastery[]
}

model Course {
  id                String         @id @default(uuid())
  code              String         @unique
  title             String
  description       String?
  allowedIpPrefixes String[]       @default([])
  teacherId         String
  teacher           User           @relation("TeacherCourses", fields: [teacherId], references: [id])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  enrollments Enrollment[]
  sessions    ClassSession[]
  assessments Assessment[]
  concepts    Concept[]
}

model Enrollment {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model ClassSession {
  id           String             @id @default(uuid())
  courseId     String
  title        String
  sessionDate  DateTime           @default(now())
  qrCodeToken  String?
  windowEndsAt DateTime?
  isActive     Boolean            @default(false)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  course      Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  attendances AttendanceRecord[]
}

model AttendanceRecord {
  id             String           @id @default(uuid())
  sessionId      String
  userId         String
  status         AttendanceStatus @default(PRESENT)
  verifiedBy     String           @default("QR") // "QR" | "FACE" | "MANUAL"
  timestamp      DateTime         @default(now())

  // Attendance Mode B fields
  faceDistance   Float?
  livenessPassed Boolean?
  codeValid      Boolean          @default(false)
  networkOk      Boolean          @default(false)
  integrityScore Float?
  method         String           @default("SELF") // SELF | CLASS_PHOTO | MANUAL
  reviewedBy     String?

  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
}

model Assessment {
  id          String       @id @default(uuid())
  courseId    String
  title       String
  description String?
  maxScore    Float        @default(100)
  dueDate     DateTime?
  published   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions Submission[]
  questions   Question[]
}

enum QuestionType {
  MCQ
  SHORT
  HANDWRITTEN
}

model Question {
  id           String            @id @default(uuid())
  assessmentId String
  conceptId    String
  type         QuestionType
  prompt       String
  maxMarks     Float
  options      String[]          @default([])
  correctIndex Int?
  modelAnswer  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  assessment   Assessment        @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  concept      Concept           @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  rubrics      RubricCriterion[]
  submissions  Submission[]
}

model RubricCriterion {
  id          String   @id @default(uuid())
  questionId  String
  description String
  marks       Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Submission {
  id            String    @id @default(uuid())
  assessmentId  String
  questionId    String?
  userId        String
  content       String?
  fileUrl       String?
  score         Float?
  feedback      String?
  selectedIndex Int?
  answerText    String?
  scanPath      String?
  ocrOriginal   String?
  ocrStatus     String?   // "OK" | "PARTIAL" | "UNREADABLE" | "FAILED"
  ocrEditedBy   String?
  ocrEditedAt   DateTime?
  submittedAt   DateTime  @default(now())
  gradedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question      Question?  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  grade         Grade?

  @@unique([userId, questionId])
  @@index([assessmentId, userId])
}

model Grade {
  id            String     @id @default(uuid())
  submissionId  String     @unique
  totalMarks    Float
  finalMarks    Float?
  confidence    Float      @default(1.0)
  needsReview   Boolean    @default(false)
  graderType    String     @default("AUTO") // "AUTO" | "LLM" | "MANUAL"
  summary       String?
  missingPoints String[]   @default([])
  gradedAt      DateTime?
  reviewedBy    String?
  reviewedAt    DateTime?
  overriddenBy  String?
  overrideNote  String?
  overriddenAt  DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

model Mastery {
  id        String   @id @default(uuid())
  userId    String
  conceptId String
  score     Float    @default(0.5)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept   Concept  @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([userId, conceptId])
}

model MasteryScore {
  id        String   @id @default(uuid())
  userId    String
  topic     String
  level     Float    @default(0.0) // 0 to 100 percentage
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topic])
}

enum ResourceDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ResourceType {
  DOCUMENT
  VIDEO
  ARTICLE
  EXERCISE
}

model Concept {
  id             String                @id @default(uuid())
  title          String
  description    String?
  order          Int                   @default(0)
  courseId       String
  course         Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  resources      Resource[]
  prerequisites  ConceptPrerequisite[] @relation("ConceptPrerequisites")
  prerequisiteFor ConceptPrerequisite[] @relation("ConceptPrerequisiteFor")
  questions      Question[]
  masteries      Mastery[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
}

model ConceptPrerequisite {
  id             String   @id @default(uuid())
  conceptId      String
  prerequisiteId String
  concept        Concept  @relation("ConceptPrerequisites", fields: [conceptId], references: [id], onDelete: Cascade)
  prerequisite   Concept  @relation("ConceptPrerequisiteFor", fields: [prerequisiteId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([conceptId, prerequisiteId])
}

model Resource {
  id          String             @id @default(uuid())
  title       String
  description String?
  url         String?
  type        ResourceType       @default(ARTICLE)
  difficulty  ResourceDifficulty @default(BEGINNER)
  conceptId   String
  concept     Concept            @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}
